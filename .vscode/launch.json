{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pipex",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/pipex",
            //"args": ["file1.txt", "grep rtt", "wc -l", "file2.txt"],
            //"args": ["Makefile", " ", " ", "outf"],
            "args": ["Makefile", "c1", "c2", "outf"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
                ,
                {
                    "description": "Follow child after fork",
                    //"text": "set follow-fork-mode child",
                    "text": "set follow-fork-mode parent",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "make" 
        }
    ]
}